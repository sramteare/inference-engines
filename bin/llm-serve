#!/usr/bin/env bash
# llm-serve - unified CLI to start, stop, and inspect local llama-server profiles.
set -euo pipefail

# Process helpers shared by --stop, --status and the launch path.
proc_cmdline() {  # $1 pid -> space-joined cmdline
  tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null
}
is_our_cmd() {  # $1 pid -> 0 if its cmdline is one of our server binaries
  local c
  c="$(proc_cmdline "$1")" || return 1
  case "$c" in
    *llama-server*|*maya.py*|*basalt*) return 0 ;;
    *) return 1 ;;
  esac
}
starttime_of() {  # $1 pid -> start time (field 22 of /proc/<pid>/stat)
  local stat rest
  stat="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
  rest="${stat##*) }"   # drop through the comm field; remainder starts at field 3 (state)
  set -- $rest          # original field N is now positional $((N - 2)), so 22 -> $20
  printf '%s' "${20:-}"
}
nvsmi() {  # nvidia-smi, guarded by a timeout when coreutils' timeout exists
  # --foreground keeps nvidia-smi in our process group so Ctrl-C reaches a hung
  # nvidia-smi; --kill-after catches one that ignores SIGTERM. Without timeout
  # on PATH, run nvidia-smi unguarded rather than lose the check entirely.
  # NVSMI_TIMEOUT_S (default 10) lets the GPU wait shrink each poll's timeout to
  # the time left before its deadline; --kill-after is always kept.
  local t="${NVSMI_TIMEOUT_S:-10}"
  if command -v timeout >/dev/null 2>&1; then
    timeout --foreground --kill-after=2 "$t" nvidia-smi "$@"
  else
    nvidia-smi "$@"
  fi
}
# GPU-holding binaries we manage. Ownership is decided only by this exact
# executable name: cmdlines can mention these names in unrelated arguments.
readonly -a GPU_SERVER_NAMES=(maya-ds4 llama-server basalt basalt-bench)
# Root for /proc lookups. Override (empty/nonexistent dir) makes the exe read
# below fail, which is how the tests reach the name-based fallback.
PROC_ROOT="${PROC_ROOT:-/proc}"
gpu_holders() {  # "<pid> <used_mib> <name>"; return 2 when the query fails, 3 when nvidia-smi is absent
  command -v nvidia-smi >/dev/null 2>&1 || return 3
  local out line pid name mem base n exe exec_part
  if ! out="$(nvsmi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null)"; then
    return 2
  fi
  while IFS= read -r line; do
    [[ -n "${line//[[:space:]]/}" ]] || continue
    [[ "$line" == *,* ]] || continue
    # process_name may be a whole command line with commas and spaces, so take
    # pid before the first comma, mem after the last, and the name in between.
    pid="${line%%,*}"
    mem="${line##*,}"
    name="${line#*,}"; name="${name%,*}"
    pid="${pid//[[:space:]]/}"
    mem="${mem//[[:space:]]/}"
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    base=""
    # Identify by the real executable: its basename must equal a known name.
    # Immune to spaces in the path and never matches an argument.
    if exe="$(readlink "$PROC_ROOT/$pid/exe" 2>/dev/null)" && [[ -n "$exe" ]]; then
      # Binary rebuilt while its process runs: Linux reports the link target
      # with a " (deleted)" suffix; strip one so the basename still matches.
      exe="${exe%" (deleted)"}"
      exe="${exe##*/}"
      for n in "${GPU_SERVER_NAMES[@]}"; do
        if [[ "$exe" == "$n" ]]; then
          base="$n"
          break
        fi
      done
    else
      # /proc exe unreadable (another user's process, or it exited between the
      # nvidia-smi query and now): fall back to the reported name, but only the
      # executable part. Arguments start at the first " -".
      exec_part="$name"
      [[ "$exec_part" == *" -"* ]] && exec_part="${exec_part%%" -"*}"
      for n in "${GPU_SERVER_NAMES[@]}"; do
        if [[ "${exec_part##*/}" == "$n" || "$name" == "$n "* ]]; then
          base="$n"
          break
        fi
      done
    fi
    [[ -n "$base" ]] || continue
    printf '%s %s %s\n' "$pid" "$mem" "$base"
  done <<< "$out"
  return 0
}
# Never inherit a caller's CONFIG_TMP: the cleanup below would delete it.
CONFIG_TMP=""
# Generated engine configs live in CONFIG_TMP until the launch checks pass.
cleanup_config_tmp() {
  if [[ -n "${CONFIG_TMP:-}" && -f "${CONFIG_TMP}" ]]; then
    rm -f -- "$CONFIG_TMP"
  fi
  return 0
}
# Remove the generated temp file and forget its path, so the traps above can
# never touch a file once this script is done with it.
discard_config_tmp() {
  if [[ -n "${CONFIG_TMP:-}" ]]; then
    rm -f -- "$CONFIG_TMP"
    CONFIG_TMP=""
  fi
}
trap cleanup_config_tmp EXIT
# A trap handler that only returns would let the script continue after Ctrl-C,
# so re-raise the signal (default disposition) after cleaning up the temp file.
trap 'cleanup_config_tmp; trap - INT; kill -INT $$' INT
trap 'cleanup_config_tmp; trap - TERM; kill -TERM $$' TERM

main() {
  # Not `local`: that would hide the environment overrides documented below.
  local ENGINES DAEMON RUN_CWD CONFIG SYNC_ALIAS SYNC_CTX
  ENGINES="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
  MODELS="${MODELS:-$HOME/dev/models}"
  LLAMA_BIN="${LLAMA_BIN:-$ENGINES/llama.cpp/build/bin/llama-server}"
  LOG_DIR="${LOG_DIR:-$ENGINES/logs}"
  HOST_SET="${HOST+1}"
  HOST="${HOST:-0.0.0.0}"
  PORT="${PORT:-8000}"
  SPEC="${SPEC:-1}"
  VISION="${VISION:-dynamic}"
  # ${VAR+set} (no colon): an explicitly set empty value still counts as set,
  # so the profile default below leaves it alone and the validation refuses it.
  GPUS_SET="${GPUS+set}"
  CONV_CACHE_MIB_SET="${CONV_CACHE_MIB+set}"
  CONV_CACHE_MIN_TOKENS_SET="${CONV_CACHE_MIN_TOKENS+set}"
  CONV_CACHE_DISK_MIB_SET="${CONV_CACHE_DISK_MIB+set}"
  CONV_CACHE_SLOTS_SET="${CONV_CACHE_SLOTS+set}"
  VRAM_RESERVE_MIB="${VRAM_RESERVE_MIB:-3072}"
  DS_NONCACHE_MIB="${DS_NONCACHE_MIB:-23000}"
  MOE_CPU_SHARE="${MOE_CPU_SHARE:-0.85}"
  MAYA_DIR="${MAYA_DIR:-$HOME/dev/maya-src}"
  BASALT_DIR="${BASALT_DIR:-$HOME/dev/basalt-builds/basalt-056}"
  BASALT_DS_DIR="${BASALT_DS_DIR:-$HOME/dev/basalt-builds/basalt-ds41-056}"
  BASALT_DS_PYTHON="${BASALT_DS_PYTHON:-$BASALT_DIR/.venv/bin/python}"
  DAEMON=0

  usage() {
    cat <<'EOF'
Usage:
  llm-serve [-d] [profile] [extra llama-server args...]
  llm-serve --status [--port N]       One-shot server & GPU status snapshot
  llm-serve --stats  [--port N ...]   Live terminal dashboard (Ctrl+C to exit)
  llm-serve --stop   [port]           Stop running server instance(s)
  llm-serve --list                    List available model profiles
  llm-serve -h | --help               Show this help message

Profiles:
  qwen            Qwen UD-Q4_K_XL on Basalt: faster, closer to BF16, image input (default)
  deepseek        DeepSeek UD-Q2_K_XL on Basalt: same quality as Maya, ~37% faster generation, reuses multi-turn prompts, image input
  deepseek-maya   DeepSeek UD-Q2_K_XL on Project Maya: faster to the first token of a long new prompt, image input
  qwen-llama      Qwen UD-Q4_K_XL + MTP Q8_0, 256k ctx, f16 KV, -fitt (llama.cpp fallback)
  deepseek-llama  DeepSeek UD-Q2_K_XL + DSpark Q8_0, 512k ctx, GPU expert cache + CPU share (llama.cpp fallback)
  qwen-basalt / deepseek-basalt  aliases of qwen / deepseek
  qwen-pair       Qwen on each card: GPU 0 on PORT, GPU 1 on PORT2 (default PORT+1); needs -d
  duo             Qwen on GPU 0 at PORT, DeepSeek on GPU 1 at PORT2 (default PORT+1); needs -d

Flags / Subcommands:
  -d                Run server in background (logs to $LOG_DIR/llama-<profile>.log)
  --status, status  Print current server status and metrics snapshot (--once)
  --stats,  stats   Launch live metrics dashboard (passes extra args to llm-stats)
  --stop,   stop    Stop running server(s): llama-server, Maya, Basalt (optionally filtered
                    by port). Pid files are verified (start time + cmdline) before anything
                    is signalled; servers are stopped by session, engine children included.
  --list,   list    List available profiles
  -h, --help, help  Show this help message

Environment overrides:
  SPEC=1|0           Enable (1, default) or disable (0) speculative decoding (MTP / DSpark)
  CTX=N              Override context window size (default: 262144 qwen, 524288 deepseek / deepseek-maya)
  VISION=MODE        Image input. qwen: dynamic (default; encoder in pinned RAM, on the GPU only for
                     requests with pictures, no VRAM at rest), cpu, off, or a GPU number.
                     deepseek: dynamic (default; the encoder runs on the GPU for requests with pictures,
                     at the cost of about one expert per layer of GPU cache), cpu, off or a GPU number.
                     deepseek-maya: on / dynamic (default, both mean on) or off. Other profiles ignore it.
  GPUS=LIST          qwen and deepseek: the cards Basalt uses, nvidia-smi numbers, the first is the
                     main card (default: 0 for qwen, 0,1 for deepseek); 0 = one card; auto = every Blackwell card.
  CONV_CACHE_MIB=N   qwen and deepseek: Basalt conversation cache RAM budget, MiB; parked conversations
                     are kept in host RAM, not VRAM; 0 turns the RAM tier off
                     (default: 16384 for qwen, 2048 for deepseek)
  CONV_CACHE_SLOTS=N qwen and deepseek: most conversations kept in the RAM tier, at least 1; ignored
                     when CONV_CACHE_MIB=0; the disk tier is limited only by its budget
                     (default: 4 for qwen, 16 for deepseek)
  CONV_CACHE_MIN_TOKENS=N
                     qwen and deepseek: park only conversations at least this many tokens, on both the
                     RAM and the disk tier (default: 32768 for qwen, 8192 for deepseek)
  CONV_CACHE_DISK_MIB=N
                     qwen and deepseek: conversation cache disk budget, MiB; the disk tier spills to
                     host disk, not VRAM, and also keeps conversations across server restarts;
                     0 turns the disk tier off (default: 65536 for qwen, 16384 for deepseek)
  The CONV_CACHE_* names are shared: a value exported for qwen also applies to deepseek.
  PORT=N             Server port (default: 8000)
  PORT2=N            qwen-pair and duo: port of the second (GPU 1) server (default: PORT+1)
  HOST=ADDR          Bind address (default: 0.0.0.0; 127.0.0.1 for qwen, deepseek and deepseek-maya, the Basalt/Maya profiles)
  MODELS=DIR         Models root directory (default: ~/dev/models)
  LOG_DIR=DIR        Log directory (default: ~/dev/engines/logs)
  VRAM_RESERVE_MIB=N VRAM left free for the desktop, MiB (default: 3072)
  MOE_CACHE_MIB=N    deepseek-llama MoE cache size, MiB (default: free VRAM - reserve - other)
  MOE_CPU_SHARE=F    deepseek-llama share of MoE cache misses computed on CPU from RAM experts instead of uploaded to GPU (default: 0.85)
  DS_NONCACHE_MIB=N  deepseek-llama non-cache VRAM estimate for the cache calc, MiB (default: 23000)
  MAYA_DIR=DIR       Project Maya engine directory (default: ~/dev/maya-src)
  BASALT_DIR=DIR     Basalt engine directory (default: ~/dev/basalt-builds/basalt-056, Basalt 0.5.6)
  BASALT_DS_DIR=DIR  Basalt build the deepseek profile runs (default: ~/dev/basalt-builds/basalt-ds41-056: 0.5.6 with
                     the MXFP4/IQ3_S expert support of upstream PR #481, which BASALT_DIR lacks)
  BASALT_DS_PYTHON=P Python running the BASALT_DS_DIR server (default: $BASALT_DIR/.venv/bin/python;
                     both default builds' .venv links to ~/dev/basalt-src/.venv, so keep that checkout)
  DRY_RUN=1          Print the full launch command (plus the generated config for
                     qwen / deepseek / deepseek-maya) and exit (no server, no opencode sync, nothing
                     written to LOG_DIR)
  GPU_WAIT_S=N       Seconds to wait for another of our servers to release GPU
                     memory before refusing to start (default: 60). Counts any
                     process with those executable names, whichever user runs
                     it, holding memory on any GPU in the machine (not only the
                     one the new server will use).
  ALLOW_SHARED_GPU=1 Start even if another of our servers still holds GPU memory
EOF
  }

  do_stop() {
    local target_port="${1:-}"
    find_pids() {
      if [[ -n "$target_port" ]]; then
        # exact --port argument match, not a substring of the whole command line
        pgrep -a -x llama-server | awk -v p="$target_port" '
          { for (i = 2; i <= NF; i++)
              if (($i == "--port" && $(i + 1) == p) || $i == "--port=" p) { print $1; next } }'
      else
        pgrep -x llama-server
      fi
    }
    stop_session() {  # returns 0 only if a signal was actually delivered
      local sid="$1"
      pkill -TERM -s "$sid" 2>/dev/null || return 1
      for _ in {1..60}; do
        pgrep -s "$sid" >/dev/null 2>&1 || return 0
        sleep 0.5
      done
      pkill -KILL -s "$sid" 2>/dev/null || true
    }
    stop_pidfile() {
      # "<pgid> <starttime>" (old files hold just "<pgid>"). Only signal once the
      # group still belongs to one of our servers: recorded start time still
      # matches /proc/<pgid>/stat (when recorded) AND the cmdline is ours.
      # A failed check means the pid was recycled: drop the file, signal nothing.
      local f="$1" pgid="" starttime=""
      { read -r pgid starttime; } < "$f" || true
      if [[ "$pgid" =~ ^[0-9]+$ ]] && is_our_cmd "$pgid" &&
         { [[ -z "$starttime" ]] || [[ "$(starttime_of "$pgid" || true)" == "$starttime" ]]; }; then
        if stop_session "$pgid"; then   # setsid at launch: pgid == sid
          rm -f "$f"
          return 0
        fi
      fi
      rm -f "$f"
      return 1
    }
    stop_listener() {
      # a server found via its listening socket: stop the whole session when it
      # leads one (setsid launch); otherwise the process alone.
      local pid="$1" sid
      sid="$(ps -o sess= -p "$pid" 2>/dev/null | tr -d '[:space:]')"
      if [[ "$sid" == "$pid" ]]; then
        stop_session "$sid"
      else
        kill -TERM "$pid" 2>/dev/null || return 1
        for _ in {1..60}; do
          kill -0 "$pid" 2>/dev/null || return 0
          sleep 0.5
        done
        kill -KILL "$pid" 2>/dev/null || true
      fi
    }

    local stopped=0 refused=0 f pids pid
    if [[ -n "$target_port" ]]; then
      if [[ -f "$LOG_DIR/serve-$target_port.pid" ]]; then
        stop_pidfile "$LOG_DIR/serve-$target_port.pid" && stopped=1
      else
        pids="$(ss -ltnpH "sport = :$target_port" 2>/dev/null | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u || true)"
        for pid in $pids; do
          if is_our_cmd "$pid"; then
            stop_listener "$pid" && stopped=1
          else
            refused=1
            echo "Port $target_port is held by pid $pid: $(proc_cmdline "$pid" || echo 'unknown process') - not a server we manage, leaving it alone."
          fi
        done
      fi
    else
      for f in "$LOG_DIR"/serve-*.pid; do
        [[ -e "$f" ]] || continue
        stop_pidfile "$f" && stopped=1
      done
      # Basalt/Maya servers without a pid file (e.g. started in the foreground).
      local -a pids2=()
      mapfile -t pids2 < <(ss -ltnpH 2>/dev/null | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -un || true)
      for pid in "${pids2[@]}"; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        is_our_cmd "$pid" || continue
        stop_listener "$pid" && stopped=1
      done
    fi

    pids="$(find_pids || true)"
    if [[ -n "$pids" ]]; then
      stopped=1
      kill $pids 2>/dev/null || true
      for _ in {1..20}; do
        [[ -z "$(find_pids || true)" ]] && break
        sleep 0.5
      done
      pids="$(find_pids || true)"
      [[ -n "$pids" ]] && { echo "Still running; forcing."; kill -9 $pids 2>/dev/null || true; }
    fi

    if [[ -n "$target_port" ]]; then
      if (( refused && ! stopped )); then
        echo "Port $target_port still in use (not one of our servers)." >&2
        return 1
      fi
      for _ in {1..60}; do
        ss -ltnH "sport = :$target_port" 2>/dev/null | grep -q . || break
        sleep 0.5
      done
      if ss -ltnH "sport = :$target_port" 2>/dev/null | grep -q .; then
        echo "Port $target_port still in use." >&2
        return 1
      fi
    fi
    if (( stopped )); then
      echo "Stopped."
    else
      echo "No server running."
    fi
  }

  do_status() {
    # --port N filters the servers to show; everything else goes to llm-stats.
    local port_filter=""
    local -a REST=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --port)
          shift
          if [[ $# -gt 0 ]]; then port_filter="$1"; shift; fi
          ;;
        --port=*) port_filter="${1#--port=}"; shift ;;
        *) REST+=("$1"); shift ;;
      esac
    done

    # Server pid plus the pids of its engine processes. Basalt runs bin/basalt
    # in its own group but in the server's session (setsid at launch), so list
    # the whole session when the pid leads one - the same set --stop signals.
    group_pids() {
      local pid="$1" kids sid
      sid="$(ps -o sess= -p "$pid" 2>/dev/null | tr -d '[:space:]')"
      if [[ "$sid" == "$pid" ]]; then
        printf '%s' "$(pgrep -s "$pid" 2>/dev/null | tr '\n' ',' | sed 's/,$//' || true)"
      elif kill -0 "$pid" 2>/dev/null; then
        kids="$(pgrep -P "$pid" 2>/dev/null | tr '\n' ',' || true)"
        printf '%s' "$pid${kids:+,${kids%,}}"
      else
        printf '%s' "$(pgrep -s "$pid" 2>/dev/null | tr '\n' ',' | sed 's/,$//' || true)"
      fi
    }

    # One entry per running server: pid files first (process groups), then any
    # server found by its listening socket (no pid file, e.g. started in the
    # foreground) that is not already covered by one of those groups.
    local -a TARGETS=() PORTS=() CMDS=()
    local group_pgids="" seen_pids="" f pgid starttime port pid cmd
    for f in "$LOG_DIR"/serve-*.pid; do
      [[ -e "$f" ]] || continue
      pgid=""; starttime=""
      { read -r pgid starttime; } < "$f" || true
      [[ "$pgid" =~ ^[0-9]+$ ]] || continue
      # a recycled pid must not masquerade as our server (same checks as --stop)
      is_our_cmd "$pgid" || continue
      [[ -z "$starttime" || "$(starttime_of "$pgid" || true)" == "$starttime" ]] || continue
      kill -0 -- "-$pgid" 2>/dev/null || continue
      group_pgids="$group_pgids $pgid"
      port="$(basename "$f" .pid)"
      port="${port#serve-}"
      [[ -z "$port_filter" || "$port" == "$port_filter" ]] || continue
      TARGETS+=("$pgid"); PORTS+=("$port")
      CMDS+=("$(ps -o cmd= -p "$(group_pids "$pgid")" 2>/dev/null | tr '\n' ' ' || true)")
    done
    while read -r port pid; do
      [[ "${pid:-}" =~ ^[0-9]+$ ]] || continue
      if [[ " $seen_pids " == *" $pid "* ]]; then continue; fi   # one entry per pid
      cmd="$(ps -o cmd= -p "$pid" 2>/dev/null || true)"
      case "$cmd" in
        *llama-server*|*maya.py*|*basalt*) ;;
        *) continue ;;
      esac
      pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)"
      if [[ -n "$pgid" && " $group_pgids " == *" $pgid "* ]]; then continue; fi
      seen_pids="$seen_pids $pid"
      [[ -z "$port_filter" || "$port" == "$port_filter" ]] || continue
      TARGETS+=("$pid"); PORTS+=("$port")
      CMDS+=("$(ps -o cmd= -p "$(group_pids "$pid")" 2>/dev/null | tr '\n' ' ' || true)")
    done < <(ss -ltnpH 2>/dev/null | awk '$1 == "LISTEN" && match($0, /pid=[0-9]+/) {
                port = $4; sub(/.*:/, "", port); print port + 0, substr($0, RSTART + 4, RLENGTH - 4)
              }' | sort -n || true)

    if [[ ${#TARGETS[@]} -eq 0 ]]; then
      echo "No server running."
      if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,power.draw,temperature.gpu \
          --format=csv,noheader | awk -F', ' '{printf "GPU: %s | Util: %s | VRAM: %s / %s | Power: %s | Temp: %s C\n", $1, $2, $3, $4, $5, $6}' || true
      fi
      return 0
    fi

    local i engine elabel profile model alias
    for i in "${!TARGETS[@]}"; do
      cmd="${CMDS[$i]}"
      engine="auto"; elabel="unknown"; profile="-"
      case "$cmd" in
        *llama-server*) engine="llamacpp"; elabel="llama.cpp" ;;
        *maya.py*) engine="maya"; elabel="Maya"; profile="deepseek-maya" ;;
        *basalt*)
          engine="basalt"; elabel="Basalt"
          case "$cmd" in
            *basalt-deepseek.json*) profile="deepseek" ;;
            *) profile="qwen" ;;
          esac
          ;;
      esac
      model=""
      if command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        model="$(curl -s -m 2 "http://127.0.0.1:${PORTS[$i]}/v1/models" | jq -r '.data[0].id // empty' 2>/dev/null || true)"
      fi
      alias="$(printf '%s' "$cmd" | grep -oE -- '--alias [^ ]+' | head -n1 | cut -d' ' -f2 || true)"
      [[ -n "$model" ]] || model="$alias"
      if [[ "$engine" == "llamacpp" ]]; then
        case "$model" in
          qwen3.8-flash-next) profile="qwen-llama" ;;
          deepseek-v4.1-flash) profile="deepseek-llama" ;;
        esac
      elif [[ "$engine" == "basalt" && "$profile" == "qwen" ]]; then
        # no basalt-deepseek.json on the command line: the served model id
        # refines the guess; the qwen default stands only without a model id.
        case "$model" in
          deepseek-v4.1-flash) profile="deepseek" ;;
          qwen3.8-flash-next) profile="qwen" ;;
        esac
      fi
      [[ -n "$model" ]] || model="-"
      echo "== port ${PORTS[$i]} | engine $elabel | profile $profile | model $model"
      ps -o pid,etime,%cpu,%mem,rss,cmd -p "$(group_pids "${TARGETS[$i]}")" 2>/dev/null | cut -c1-150 || true
      "$ENGINES/bin/llm-stats" --port "${PORTS[$i]}" --host 127.0.0.1 --engine "$engine" --once "${REST[@]}" || true
      echo
    done
  }

  if [[ "${1:-}" == "-d" ]]; then
    DAEMON=1
    shift
  fi

  case "${1:-}" in
    -h|--help|help)
      usage
      return 0
      ;;
    --list|list)
      echo "Profiles:"
      echo "  qwen            Qwen UD-Q4_K_XL on Basalt: faster, closer to BF16, image input (default)"
      echo "  deepseek        DeepSeek UD-Q2_K_XL on Basalt: same quality as Maya, ~37% faster generation, reuses multi-turn prompts, image input"
      echo "  deepseek-maya   DeepSeek UD-Q2_K_XL on Project Maya: faster to the first token of a long new prompt, image input"
      echo "  qwen-llama      Qwen UD-Q4_K_XL + MTP Q8_0, 256k ctx, f16 KV, -fitt (llama.cpp fallback)"
      echo "  deepseek-llama  DeepSeek UD-Q2_K_XL + DSpark Q8_0, 512k ctx, GPU expert cache + CPU share (llama.cpp fallback)"
      echo "  qwen-basalt / deepseek-basalt  aliases of qwen / deepseek"
      echo "  qwen-pair       Qwen on each card: GPU 0 on PORT, GPU 1 on PORT2 (default PORT+1); needs -d"
      echo "  duo             Qwen on GPU 0 at PORT, DeepSeek on GPU 1 at PORT2 (default PORT+1); needs -d"
      return 0
      ;;
    --stop|stop)
      shift
      do_stop "${1:-}"
      return 0
      ;;
    --status|status)
      shift
      do_status "$@"
      return 0
      ;;
    --stats|stats)
      shift
      exec "$ENGINES/bin/llm-stats" --port "$PORT" "$@"
      ;;
  esac

  local PROFILE="${1:-qwen}"
  [[ $# -gt 0 ]] && shift
  case "$PROFILE" in
    qwen-basalt) PROFILE="qwen" ;;
    deepseek-basalt) PROFILE="deepseek" ;;
  esac

  # Validate the profile name before the port check and the GPU wait, so a typo
  # fails instantly, not after GPU_WAIT_S. Keep this list in sync with the
  # profile case below.
  case "$PROFILE" in
    qwen|qwen-pair|duo|deepseek|deepseek-maya|qwen-llama|deepseek-llama) ;;
    *)
      echo "Unknown profile or flag: $PROFILE (try: llm-serve --help)" >&2
      return 1
      ;;
  esac
  # Internal (set by qwen-pair for the GPU 1 server; empty otherwise): suffix
  # for the qwen config, log and conversation folder, so it must be path-safe.
  if [[ -n "${LLM_SERVE_INSTANCE:-}" && ! "$LLM_SERVE_INSTANCE" =~ ^[a-z0-9-]+$ ]]; then
    echo "llm-serve: LLM_SERVE_INSTANCE must match ^[a-z0-9-]+$ (got: $LLM_SERVE_INSTANCE)" >&2
    return 1
  fi
  # Qwen on two cards is no faster than on one (all its experts fit on one
  # card), but two single-card servers each run at full speed: re-run this
  # script once per card. Only in the background: the foreground would show
  # and own the first server while the second one waits. duo runs Qwen on
  # card 0 and DeepSeek on card 1 the same way.
  if [[ "$PROFILE" == qwen-pair || "$PROFILE" == duo ]]; then
    if [[ ! "$PORT" =~ ^[0-9]+$ ]]; then
      echo "llm-serve: $PROFILE: PORT must be a number (got: $PORT)" >&2
      return 1
    fi
    local port2="${PORT2:-$(( 10#$PORT + 1 ))}"
    if [[ ! "$port2" =~ ^[0-9]+$ ]]; then
      echo "llm-serve: $PROFILE: PORT2 must be a number (got: $port2)" >&2
      return 1
    fi
    # Both passed ^[0-9]+$ above, so 10#$... inside (( )) is safe (it also
    # keeps leading-zero values out of octal).
    if (( 10#$PORT < 1 || 10#$PORT > 65535 )); then
      echo "llm-serve: $PROFILE: PORT must be between 1 and 65535 (got: $PORT)" >&2
      return 1
    fi
    if (( 10#$port2 < 1 || 10#$port2 > 65535 )); then
      echo "llm-serve: $PROFILE: PORT2 must be between 1 and 65535 (got: $port2)" >&2
      return 1
    fi
    # Compare as numbers, so e.g. 08000 and 8000 count as the same port.
    if (( 10#$PORT == 10#$port2 )); then
      echo "llm-serve: $PROFILE: PORT2 must differ from PORT (both $PORT)" >&2
      return 1
    fi
    # Fail fast on a busy port, before the first server is even started.
    if [[ "${DRY_RUN:-0}" != 1 ]]; then
      local p
      for p in "$PORT" "$port2"; do
        if ss -ltnH "sport = :$p" 2>/dev/null | grep -q .; then
          echo "llm-serve: $PROFILE: Something is already listening on port $p. Stop it with: llm-serve --stop $p" >&2
          return 1
        fi
      done
    fi
    if (( ! DAEMON )) && [[ "${DRY_RUN:-0}" != 1 ]]; then
      echo "llm-serve: $PROFILE runs two background servers: use llm-serve -d $PROFILE" >&2
      return 1
    fi
    local rc=0
    # LLM_SERVE_INSTANCE= clears any inherited value: card 0 is the base
    # server, no matter what the caller had set.
    LLM_SERVE_INSTANCE= GPUS=0 PORT="$PORT" "$0" -d qwen "$@" || rc=$?
    if (( rc != 0 )); then
      return "$rc"
    fi
    # The first server is ours and holds card 0: the second must not wait for it.
    if [[ "$PROFILE" == duo ]]; then
      # Qwen and deepseek already use separate configs, logs and conversation
      # folders, so the second server needs no LLM_SERVE_INSTANCE here.
      LLM_SERVE_INSTANCE= GPUS=1 PORT="$port2" ALLOW_SHARED_GPU=1 OPENCODE_SYNC=0 \
        "$0" -d deepseek "$@" || rc=$?
    else
      GPUS=1 PORT="$port2" ALLOW_SHARED_GPU=1 OPENCODE_SYNC=0 LLM_SERVE_INSTANCE=gpu1 \
        "$0" -d qwen "$@" || rc=$?
    fi
    if (( rc != 0 )); then
      echo "llm-serve: $PROFILE: the second server (port $port2) did not start; the first is still running on port $PORT (stop it with: llm-serve --stop $PORT)" >&2
    fi
    return "$rc"
  fi
  # Only qwen, deepseek and deepseek-maya read VISION; check it here so a typo
  # also fails before the GPU wait. Maya's --vision is a plain on/off switch.
  if [[ "$PROFILE" == qwen && ! "$VISION" =~ ^(off|dynamic|cpu|[0-9]+)$ ]]; then
    echo "llm-serve: VISION must be off, dynamic, cpu or a GPU number (got: $VISION)" >&2
    return 1
  fi
  if [[ "$PROFILE" == deepseek && ! "$VISION" =~ ^(off|dynamic|cpu|[0-9]+)$ ]]; then
    echo "llm-serve: deepseek: VISION must be off, dynamic, cpu or a GPU number (got: $VISION)" >&2
    return 1
  fi
  if [[ "$PROFILE" == deepseek-maya && ! "$VISION" =~ ^(on|dynamic|off)$ ]]; then
    echo "llm-serve: deepseek-maya: VISION must be on, dynamic or off (got: $VISION)" >&2
    return 1
  fi
  # GPUS defaults are per-profile: all Qwen experts fit on one card, DeepSeek
  # is faster on two. An explicitly set GPUS (even an empty one, refused below)
  # wins for either profile.
  if [[ -z "$GPUS_SET" ]]; then
    case "$PROFILE" in
      deepseek) GPUS="0,1" ;;
      *) GPUS="0" ;;
    esac
  fi
  # Only qwen and deepseek read GPUS; check it here like VISION, before the GPU
  # wait and any start, so a bad value fails fast (also under DRY_RUN). Basalt
  # wants nvidia-smi card numbers, comma-separated (the first is the main card),
  # or auto.
  if [[ ( "$PROFILE" == qwen || "$PROFILE" == deepseek ) && ! "$GPUS" =~ ^(auto|[0-9]+(,[0-9]+)*)$ ]]; then
    echo "llm-serve: GPUS must be auto or card numbers like 0 or 0,1 (got: $GPUS)" >&2
    return 1
  fi
  # Conversation cache defaults are per-profile; an explicitly set value (even
  # an empty one, refused below) wins for either profile.
  case "$PROFILE" in
    qwen)
      [[ -n "$CONV_CACHE_MIB_SET" ]] || CONV_CACHE_MIB=16384
      [[ -n "$CONV_CACHE_MIN_TOKENS_SET" ]] || CONV_CACHE_MIN_TOKENS=32768
      [[ -n "$CONV_CACHE_DISK_MIB_SET" ]] || CONV_CACHE_DISK_MIB=65536
      [[ -n "$CONV_CACHE_SLOTS_SET" ]] || CONV_CACHE_SLOTS=4
      ;;
    deepseek)
      [[ -n "$CONV_CACHE_MIB_SET" ]] || CONV_CACHE_MIB=2048
      [[ -n "$CONV_CACHE_MIN_TOKENS_SET" ]] || CONV_CACHE_MIN_TOKENS=8192
      [[ -n "$CONV_CACHE_DISK_MIB_SET" ]] || CONV_CACHE_DISK_MIB=16384
      [[ -n "$CONV_CACHE_SLOTS_SET" ]] || CONV_CACHE_SLOTS=16
      ;;
  esac
  # Only qwen and deepseek read the Basalt conversation cache knobs; validate them
  # like VISION, before the GPU wait and any start, so a typo fails fast (also
  # under DRY_RUN).
  # No leading zeros and at most 9 digits: Basalt only refuses out-of-range values at engine start.
  if [[ ( "$PROFILE" == qwen || "$PROFILE" == deepseek ) && ! "$CONV_CACHE_MIB" =~ ^(0|[1-9][0-9]{0,8})$ ]]; then
    echo "llm-serve: CONV_CACHE_MIB must be a non-negative integer of at most 9 digits (got: $CONV_CACHE_MIB)" >&2
    return 1
  fi
  if [[ ( "$PROFILE" == qwen || "$PROFILE" == deepseek ) && ! "$CONV_CACHE_MIN_TOKENS" =~ ^(0|[1-9][0-9]{0,8})$ ]]; then
    echo "llm-serve: CONV_CACHE_MIN_TOKENS must be a non-negative integer of at most 9 digits (got: $CONV_CACHE_MIN_TOKENS)" >&2
    return 1
  fi
  if [[ ( "$PROFILE" == qwen || "$PROFILE" == deepseek ) && ! "$CONV_CACHE_DISK_MIB" =~ ^(0|[1-9][0-9]{0,8})$ ]]; then
    echo "llm-serve: CONV_CACHE_DISK_MIB must be a non-negative integer of at most 9 digits (got: $CONV_CACHE_DISK_MIB)" >&2
    return 1
  fi
  if [[ ( "$PROFILE" == qwen || "$PROFILE" == deepseek ) && ! "$CONV_CACHE_SLOTS" =~ ^(0|[1-9][0-9]{0,8})$ ]]; then
    echo "llm-serve: CONV_CACHE_SLOTS must be a non-negative integer of at most 9 digits (got: $CONV_CACHE_SLOTS)" >&2
    return 1
  fi
  # Launcher rule: 0 slots would silently turn the RAM tier off (Basalt only warns on qwen);
  # use CONV_CACHE_MIB=0 for that. Skipped when the RAM tier is off anyway.
  if [[ ( "$PROFILE" == qwen || "$PROFILE" == deepseek ) && "$CONV_CACHE_MIB" != 0
         && "$CONV_CACHE_SLOTS" == 0 ]]; then
    echo "llm-serve: CONV_CACHE_SLOTS must be at least 1 (got: $CONV_CACHE_SLOTS)" >&2
    return 1
  fi

  # DRY_RUN must leave LOG_DIR untouched; engine configs are generated into a
  # temp file and only written to $CONFIG after the port check below passes.
  [[ "${DRY_RUN:-0}" == 1 ]] || mkdir -p "$LOG_DIR"
  local -a ARGS=() CMD=()
  RUN_CWD="" CONFIG="" CONFIG_TMP="" SYNC_ALIAS="" SYNC_CTX=""

  # Fail fast on a busy port, before spending up to GPU_WAIT_S waiting for the
  # GPU: the holder there is often the very server occupying this port.
  if [[ "${DRY_RUN:-0}" != 1 ]] && ss -ltnH "sport = :$PORT" 2>/dev/null | grep -q .; then
    echo "Something is already listening on port $PORT. Stop it with: llm-serve --stop $PORT" >&2
    return 1
  fi

  # Refuse to start while another server still holds GPU memory: the new engine
  # would come up degraded on the leftovers, and profiles below (deepseek-llama)
  # size their VRAM caches from a reading taken after the holder is gone.
  # DRY_RUN stays side-effect free: no wait, no nvidia-smi compute-apps query.
  local did_wait=0
  if [[ "${DRY_RUN:-0}" != 1 && "${ALLOW_SHARED_GPU:-0}" != 1 ]]; then
    local holders holders_rc pid mem name wait_s first_holder deadline_ns poll poll_rc
    wait_s="${GPU_WAIT_S:-60}"
    if [[ ! "$wait_s" =~ ^[0-9]{1,6}$ ]]; then
      echo "llm-serve: GPU_WAIT_S must be a whole number of seconds" >&2
      return 1
    fi
    wait_s=$(( 10#$wait_s ))
    # A failed first query means we cannot tell: fail open and start as before.
    # A missing nvidia-smi (rc 3) is the usual headless-free laptop case: stay quiet.
    holders="$(gpu_holders)" && holders_rc=0 || holders_rc=$?
    if (( holders_rc == 2 )); then
      echo "llm-serve: could not query nvidia-smi; starting without the GPU check" >&2
    fi
    if (( holders_rc == 0 )) && [[ -n "$holders" ]]; then
      first_holder=1
      while read -r pid mem name; do
        if (( first_holder )); then
          echo "Waiting for GPU memory: pid $pid ($name, $mem MiB) is still running ... (up to $wait_s s; ALLOW_SHARED_GPU=1 starts anyway)"
          first_holder=0
        else
          echo "Waiting for GPU memory: pid $pid ($name, $mem MiB) is still running ..."
        fi
      done <<< "$holders"
      did_wait=1
      deadline_ns=$(( $(date +%s%N) + wait_s * 1000000000 ))
      while :; do
        # A poll's nvidia-smi can block for its timeout plus --kill-after, so cap
        # this poll's timeout at the whole seconds left before the deadline (min
        # 1); otherwise a single poll can overshoot GPU_WAIT_S by ~12 s.
        NVSMI_TIMEOUT_S=$(( (deadline_ns - $(date +%s%N) + 999999999) / 1000000000 ))
        (( NVSMI_TIMEOUT_S < 1 )) && NVSMI_TIMEOUT_S=1
        # A failed poll mid-wait keeps the previous holders (still busy).
        poll="$(gpu_holders)" && poll_rc=0 || poll_rc=$?
        if (( poll_rc == 0 )); then
          holders="$poll"
          if [[ -z "$holders" ]]; then
            break
          fi
        fi
        if (( $(date +%s%N) >= deadline_ns )); then
          while read -r pid mem name; do
            echo "pid $pid ($name, $mem MiB) is still holding GPU memory." >&2
          done <<< "$holders"
          while read -r pid mem name; do
            echo "Stop pid $pid ($name) - llm-serve --stop if it is one of its servers - or set ALLOW_SHARED_GPU=1 to start anyway." >&2
          done <<< "$holders"
          return 1
        fi
        sleep 0.5
      done
    fi
  fi
  # Restore the full timeout for later nvidia-smi calls (deepseek-llama sizing).
  NVSMI_TIMEOUT_S=10

  # The holder can exit just as something else grabs the port: check again.
  if (( did_wait )); then
    if ss -ltnH "sport = :$PORT" 2>/dev/null | grep -q .; then
      echo "Something is already listening on port $PORT. Stop it with: llm-serve --stop $PORT" >&2
      return 1
    fi
  fi

  case "$PROFILE" in
    qwen-llama)
      # Qwen3.8-Flash-Next UD-Q4_K_XL + MTP Q8_0 draft head, 256k native ctx (set CTX=524288 for YaRN 2x)
      local ctx="${CTX:-262144}"
      ARGS=(
        -m  "$MODELS/qwen3.8-unsloth-v3.1/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf"
        -c "$ctx" -np 1
        -ctk f16 -ctv f16 -fa on
        -ub 1024 -b 2048
        -fitt "$VRAM_RESERVE_MIB"
        --load-mode none
        --alias qwen3.8-flash-next
      )
      if (( SPEC )); then
        ARGS+=(-md "$MODELS/qwen3.8-unsloth-v3.1/MTP/mtp-Qwen3.8-Flash-Next-Q8_0.gguf" --spec-type draft-mtp --spec-draft-n-max 2)
      fi
      if (( ctx > 262144 )); then
        ARGS+=(--rope-scaling yarn --rope-scale 2 --yarn-orig-ctx 262144)
      fi
      SYNC_ALIAS="qwen3.8-flash-next"
      SYNC_CTX="$ctx"
      ;;
    deepseek-llama)
      # DeepSeek-V4.1-Flash-1017 UD-Q2_K_XL (~312 GiB) + DSpark Q8_0 drafter.
      # NOTE: larger than VRAM+RAM, so part of it is paged from disk via mmap.
      # Benchmark: -cmoe with a VRAM-sized MoE cache beats -fit on here.
      local ctx="${CTX:-524288}"
      local cache="${MOE_CACHE_MIB:-}"
      if [[ -z "$cache" ]]; then
        local free
        if free="$(nvsmi --query-gpu=memory.free --format=csv,noheader,nounits -i 0 2>/dev/null | tr -d '[:space:]')" && [[ "$free" =~ ^[0-9]+$ ]]; then
          cache=$(( free - VRAM_RESERVE_MIB - DS_NONCACHE_MIB ))
          if (( cache < 8000 )); then
            echo "deepseek-llama: warning: only $free MiB VRAM free; is another model still loaded? (llm-serve --status)" >&2
            cache=8000
          fi
          echo "deepseek-llama: MoE cache $cache MiB (free $free - reserve $VRAM_RESERVE_MIB - other $DS_NONCACHE_MIB)"
        else
          cache=60000
          echo "deepseek-llama: nvidia-smi failed; falling back to MoE cache $cache MiB" >&2
        fi
      fi
      ARGS=(
        -m  "$MODELS/deepseek-v41-1017/UD-Q2_K_XL/DeepSeek-V4.1-Flash-1017-UD-Q2_K_XL-00001-of-00007.gguf"
        -c "$ctx" -np 1
        -ctk q8_0 -ctv q8_0 -fa on
        -ngl 99 -cmoe --moe-cache-mib "$cache" --moe-cache-cpu-share "$MOE_CPU_SHARE"
        --alias deepseek-v4.1-flash
      )
      if (( SPEC )); then
        ARGS+=(-md "$MODELS/deepseek-v41-1017/dspark-DeepSeek-V4.1-Flash-1017-Q8_0.gguf" --spec-type draft-dspark --spec-draft-n-max 3)
      fi
      SYNC_ALIAS="deepseek-v4.1-flash"
      SYNC_CTX="$ctx"
      ;;
    deepseek)
      # DeepSeek-V4.1-Flash-1017 UD-Q2_K_XL on the Basalt engine.
      # answer-room 0: Basalt's default caps thinking at half of max_tokens.
      # +700 on the reserve: vram-reserve-mib doubles as Basalt's own scratch reserve.
      # Runs from BASALT_DS_DIR (MXFP4/IQ3_S expert support BASALT_DIR lacks),
      # server started with --python BASALT_DS_PYTHON (default: BASALT_DIR's .venv).
      # vision is the image encoder, dynamic by default.
      local ctx="${CTX:-524288}"
      [[ -n "$HOST_SET" ]] || HOST="127.0.0.1"
      CONFIG="$LOG_DIR/basalt-deepseek.json"
      if [[ ! -x "$BASALT_DS_DIR/bin/basalt" ]]; then
        echo "deepseek: not found: $BASALT_DS_DIR/bin/basalt (set BASALT_DS_DIR)" >&2
        return 1
      fi
      if [[ ! -x "$BASALT_DS_PYTHON" ]]; then
        echo "deepseek: not found: $BASALT_DS_PYTHON (set BASALT_DS_PYTHON)" >&2
        return 1
      fi
      CONFIG_TMP="$(mktemp)"
      jq -n \
        --arg model "$MODELS/deepseek-v41-1017/basalt/DeepSeek-V4.1-Flash-1017-UD-Q2_K_XL.vision.basalt" \
        --arg host "$HOST" \
        --argjson ctx "$ctx" \
        --argjson port "$PORT" \
        --argjson rsv "$(( VRAM_RESERVE_MIB + 700 ))" \
        --argjson spec "$SPEC" \
        --arg vision "$VISION" \
        --argjson cc_mib "$CONV_CACHE_MIB" \
        --argjson cc_min_tokens "$CONV_CACHE_MIN_TOKENS" \
        --argjson cc_disk_mib "$CONV_CACHE_DISK_MIB" \
        --argjson cc_slots "$CONV_CACHE_SLOTS" \
        --arg gpus "$GPUS" \
        '{version: 2,
          models: [{alias: "deepseek-v4.1-flash", model: $model, gpu: $gpus}],
          engine: ({"max-context": $ctx, "vram-reserve-mib": $rsv, "answer-room": 0,
                    vision: (if ($vision | test("^[0-9]+$")) then ($vision | tonumber) else $vision end)}
                   + (if $spec == 0 then {spec: 0} else {} end)
                   + (if $cc_mib > 0 then {"conversation-cache-mib": $cc_mib,
                                           "conversation-cache-slots": $cc_slots} else {} end)
                   + (if ($cc_mib > 0 or $cc_disk_mib > 0) then
                        {"conversation-cache-min-tokens": $cc_min_tokens} else {} end)
                   + (if $cc_disk_mib > 0 then {"conversation-cache-disk-mib": $cc_disk_mib} else {} end)),
          server: {host: $host, port: $port}}' > "$CONFIG_TMP"
      RUN_CWD="$BASALT_DS_DIR"
      CMD=("$BASALT_DS_DIR/bin/basalt" serve --config "$CONFIG" --python "$BASALT_DS_PYTHON" "$@")
      SYNC_ALIAS="deepseek-v4.1-flash"
      SYNC_CTX="$ctx"
      ;;
    deepseek-maya)
      # DeepSeek-V4.1-Flash-1017 UD-Q2_K_XL on the Project Maya engine.
      # Config = the maya template minus the refusal-direction ablation args and
      # the ablate keys (this profile must never load the refusal-direction
      # file), with ctx, VRAM reserve and --vision taken from the environment
      # (--vision appended if the template lacks it).
      local ctx="${CTX:-524288}"
      [[ -n "$HOST_SET" ]] || HOST="127.0.0.1"
      CONFIG="$LOG_DIR/maya-ds4.json"
      local tpl="$MAYA_DIR/maya-ds4.json"
      if [[ ! -f "$tpl" ]]; then
        echo "deepseek-maya: template not found: $tpl (set MAYA_DIR)" >&2
        return 1
      fi
      CONFIG_TMP="$(mktemp)"
      local vis=on
      [[ "$VISION" == off ]] && vis=off
      jq --arg ctx "$ctx" --arg rsv "$VRAM_RESERVE_MIB" --arg vis "$vis" '
        .args as $a
        | .args = [ range($a | length) as $i | $a[$i]
            | select(. != "--ablate" and . != "--ablate-default"
                     and ($i == 0 or ($a[$i-1] != "--ablate" and $a[$i-1] != "--ablate-default"))) ]
        | .args as $b
        | .args = [ range($b | length) as $i
            | if $i > 0 and $b[$i-1] == "--max-context" then $ctx
              elif $i > 0 and $b[$i-1] == "--reserve-mib" then $rsv
              elif $i > 0 and $b[$i-1] == "--vision" then $vis
              else $b[$i] end ]
        | if any(.args[]; . == "--vision") then . else .args += ["--vision", $vis] end
        | del(.ablate)
        | if .sampling then .sampling |= del(.ablate) else . end
      ' "$tpl" > "$CONFIG_TMP"
      RUN_CWD="$MAYA_DIR"
      CMD=(
        "$MAYA_DIR/.venv/bin/python" "$MAYA_DIR/maya.py"
        --config "$CONFIG" --host "$HOST" --port "$PORT" "$@"
      )
      SYNC_ALIAS="deepseek-v4.1-flash"
      SYNC_CTX="$ctx"
      ;;
    qwen)
      # Qwen3.8-Flash-Next UD-Q4_K_XL on the Basalt engine.
      # answer-room 0: Basalt's default caps thinking at half of max_tokens.
      # +700 on the reserve: vram-reserve-mib doubles as Basalt's own scratch reserve.
      local ctx="${CTX:-262144}"
      [[ -n "$HOST_SET" ]] || HOST="127.0.0.1"
      # LLM_SERVE_INSTANCE (qwen-pair's second server) separates the config.
      CONFIG="$LOG_DIR/basalt-qwen${LLM_SERVE_INSTANCE:+-$LLM_SERVE_INSTANCE}.json"
      CONFIG_TMP="$(mktemp)"
      jq -n \
        --arg model "$MODELS/qwen3.8-unsloth-v3.1/basalt/Qwen3.8-FN-UD-Q4_K_XL.basalt" \
        --arg host "$HOST" \
        --argjson ctx "$ctx" \
        --argjson port "$PORT" \
        --argjson rsv "$(( VRAM_RESERVE_MIB + 700 ))" \
        --argjson spec "$SPEC" \
        --arg vision "$VISION" \
        --argjson cc_mib "$CONV_CACHE_MIB" \
        --argjson cc_min_tokens "$CONV_CACHE_MIN_TOKENS" \
        --argjson cc_disk_mib "$CONV_CACHE_DISK_MIB" \
        --argjson cc_slots "$CONV_CACHE_SLOTS" \
        --arg gpus "$GPUS" \
        --arg inst "${LLM_SERVE_INSTANCE:-}" \
        --arg cc_dir "$HOME/.cache/basalt/qwen-${LLM_SERVE_INSTANCE:-}/conversations" \
        '{version: 2,
          models: [{alias: "qwen3.8-flash-next", model: $model, gpu: $gpus, kv: "fp16"}],
          engine: ({"max-context": $ctx, "vram-reserve-mib": $rsv,
                    "resident-experts": true, "answer-room": 0,
                    vision: (if ($vision | test("^[0-9]+$")) then ($vision | tonumber) else $vision end)}
                   + (if $spec == 0 then {spec: 0} else {} end)
                   + (if $cc_mib > 0 then {"conversation-cache-mib": $cc_mib,
                                           "conversation-cache-slots": $cc_slots} else {} end)
                   + (if ($cc_mib > 0 or $cc_disk_mib > 0) then
                        {"conversation-cache-min-tokens": $cc_min_tokens} else {} end)
                   + (if $cc_disk_mib > 0 then {"conversation-cache-disk-mib": $cc_disk_mib} else {} end)
                   + (if ($inst != "" and $cc_disk_mib > 0) then
                        {"conversation-cache-dir": $cc_dir} else {} end)),
          server: {host: $host, port: $port}}' > "$CONFIG_TMP"
      RUN_CWD="$BASALT_DIR"
      CMD=("$BASALT_DIR/bin/basalt" serve --config "$CONFIG" "$@")
      SYNC_ALIAS="qwen3.8-flash-next"
      SYNC_CTX="$ctx"
      ;;
    *)
      echo "Unknown profile or flag: $PROFILE (try: llm-serve --help)" >&2
      return 1
      ;;
  esac

  # Point opencode's default model at the profile being started, so new
  # opencode sessions show the model that is actually loaded (with its limits).
  # Set OPENCODE_SYNC=0 to skip.
  sync_opencode() {
    local cfg="${OPENCODE_CONFIG_FILE:-$HOME/.config/opencode/opencode.json}"
    local provider="${OPENCODE_PROVIDER:-llamacpp}"
    [[ "${OPENCODE_SYNC:-1}" == 1 && -f "$cfg" ]] || return 0
    command -v jq >/dev/null 2>&1 || { echo "opencode: jq not found; default model not updated." >&2; return 0; }

    local alias="$SYNC_ALIAS" ctx="$SYNC_CTX"
    [[ -n "$alias" ]] || return 0

    local base
    base="$(jq -r --arg p "$provider" '.provider[$p].options.baseURL // ""' "$cfg")"
    if [[ "$base" != *":$PORT/"* ]]; then
      echo "opencode: provider '$provider' points at ${base:-nothing}, not port $PORT; default model not updated."
      return 0
    fi
    if ! jq -e --arg p "$provider" --arg m "$alias" '.provider[$p].models[$m]' "$cfg" >/dev/null; then
      echo "opencode: no '$provider/$alias' entry in $cfg; add one to sync it." >&2
      return 0
    fi

    local tmp
    tmp="$(mktemp "$cfg.XXXXXX")"
    if jq --arg p "$provider" --arg m "$alias" --arg ctx "$ctx" '
          .model = "\($p)/\($m)" | .small_model = "\($p)/\($m)"
          | if $ctx != "" then .provider[$p].models[$m].limit.context = ($ctx | tonumber) else . end
        ' "$cfg" >"$tmp"; then
      cat "$tmp" >"$cfg" && rm -f "$tmp"   # rewrite in place: keeps file mode/owner
      echo "opencode: default model -> $provider/$alias${ctx:+ (ctx $ctx)}"
    else
      rm -f "$tmp"
      echo "opencode: failed to update $cfg" >&2
    fi
  }

  if (( ${#CMD[@]} == 0 )); then
    CMD=("$LLAMA_BIN" "${ARGS[@]}" --metrics --log-timestamps --host "$HOST" --port "$PORT" "$@")
  fi

  if [[ "${DRY_RUN:-0}" == 1 ]]; then
    local line
    line="$(printf '%q ' "${CMD[@]}")"
    echo "${line% }"
    if [[ -n "$CONFIG_TMP" ]]; then
      echo "# $CONFIG"
      cat "$CONFIG_TMP"
      discard_config_tmp
    fi
    return 0
  fi

  if ss -ltnH "sport = :$PORT" 2>/dev/null | grep -q .; then
    discard_config_tmp
    echo "Something is already listening on port $PORT. Stop it with: llm-serve --stop $PORT" >&2
    return 1
  fi

  # the port is free: now, and not before, the live config goes into $LOG_DIR
  if [[ -n "$CONFIG_TMP" ]]; then
    cat "$CONFIG_TMP" > "$CONFIG"
    discard_config_tmp
  fi

  sync_opencode

  # LLM_SERVE_INSTANCE (qwen-pair's second server) separates its log too.
  local LOG
  if [[ "$PROFILE" == qwen && -n "${LLM_SERVE_INSTANCE:-}" ]]; then
    LOG="$LOG_DIR/llama-qwen-$LLM_SERVE_INSTANCE.log"
  else
    LOG="$LOG_DIR/llama-$PROFILE.log"
  fi

  echo "Profile: $PROFILE   Endpoint: http://$HOST:$PORT/v1   Log: $LOG"
  echo "Status:  llm-serve --status   Live stats: llm-serve --stats   Stop: llm-serve --stop"

  if (( DAEMON )); then
    local pid pgid starttime _i
    if [[ -n "$RUN_CWD" ]]; then
      ( cd "$RUN_CWD" && exec setsid nohup "${CMD[@]}" ) >"$LOG" 2>&1 < /dev/null &
    else
      setsid nohup "${CMD[@]}" >"$LOG" 2>&1 < /dev/null &
    fi
    pid=$!
    disown
    # A background job of this non-interactive script is not a group leader, so
    # setsid execs in place: the new session id (= group id) is the job's pid.
    pgid="$pid"
    starttime=""
    for _i in {1..20}; do
      starttime="$(starttime_of "$pid" || true)"
      [[ -n "$starttime" ]] && break
      sleep 0.1
    done
    echo "$pgid${starttime:+ $starttime}" > "$LOG_DIR/serve-$PORT.pid"
    echo "Started in background (PGID $pgid). Follow the log: tail -f $LOG"
  else
    if [[ -n "$RUN_CWD" ]]; then
      ( cd "$RUN_CWD" && exec "${CMD[@]}" ) 2>&1 | tee "$LOG"
    else
      "${CMD[@]}" 2>&1 | tee "$LOG"
    fi
  fi
}

main "$@"
exit $?
