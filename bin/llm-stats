#!/usr/bin/env python3
"""llm-stats - live dashboard for a running llama.cpp, Basalt or Maya server.

Usage: llm-stats [--port 8000] [--host localhost] [--interval 1] [--once] [--engine auto]
--engine auto (default) detects the engine from /health and /v1/status, and re-detects if the server goes away or changes.
Requires llama-server started with --metrics (llm-serve does this).
"""
import argparse, json, math, re, subprocess, sys, time, urllib.request

p = argparse.ArgumentParser()
p.add_argument("--host", default="localhost")
p.add_argument("--port", type=int, default=8000)
p.add_argument("--interval", type=float, default=1.0)
p.add_argument("--once", action="store_true")
p.add_argument("--engine", choices=["auto", "llamacpp", "basalt", "maya"], default="auto")
# parse_args() must NOT run at module level: importing the module under e.g. sys.argv = ["pytest", "-q"]
# would exit with an argparse error. main() parses and calls configure(); these are just safe defaults.
BASE = "http://localhost:8000"
NAMES = {"llamacpp": "llama.cpp", "basalt": "Basalt", "maya": "Maya"}
ENGINE = None                  # None = not detected yet (configure() sets it for --engine X)
AUTO = True                    # only auto mode may re-detect the engine after start
LAST_DETECT = 0.0              # monotonic time of the last detect() in auto mode


def configure(a):
    """Apply parsed options to the module globals; called by main() when run as a script."""
    global BASE, ENGINE, AUTO
    BASE = f"http://{a.host}:{a.port}"
    ENGINE = None if a.engine == "auto" else a.engine
    AUTO = a.engine == "auto"


def get(path, as_json=True, timeout=2):
    with urllib.request.urlopen(BASE + path, timeout=timeout) as r:
        body = r.read().decode()
    return json.loads(body) if as_json else body


def detect():
    """Engine id from the server's own reports, or None when unreachable."""
    ok = False
    try:
        if get("/health").get("service") == "basalt":
            return "basalt"
        ok = True
    except Exception:
        pass
    try:
        if get("/v1/status").get("service") == "maya":
            return "maya"
        ok = True
    except Exception:
        pass
    return "llamacpp" if ok else None


def prom_metrics(path):
    out = {}
    for line in get(path, as_json=False).splitlines():
        m = re.match(r"^llamacpp:(\w+)(?:\{[^}]*\})?\s+([-\d.eE+naNinf]+)$", line)
        if m:
            out[m.group(1)] = float(m.group(2))
    return out


def basalt_metrics():
    """Basalt's JSON /metrics mapped onto the llama.cpp counter names."""
    j = get("/metrics")
    j = j if isinstance(j, dict) else {}   # tolerate a malformed body: keep only dict blocks
    t, live = j.get("totals"), j.get("live")
    t, live = t if isinstance(t, dict) else {}, live if isinstance(live, dict) else {}
    slots = live.get("slots")
    slots = slots if isinstance(slots, dict) else {}
    m, prompt, reused = {}, t.get("prompt"), t.get("reused")
    if prompt is not None:
        m["prompt_tokens_total"] = prompt - (reused or 0)
    if reused is not None:
        m["prompt_tokens_cached_total"] = reused
    if t.get("prompt_ms") is not None:
        m["prompt_seconds_total"] = t["prompt_ms"] / 1000
    if t.get("written") is not None:
        m["tokens_predicted_total"] = t["written"]
    if t.get("decode_ms") is not None:
        m["tokens_predicted_seconds_total"] = t["decode_ms"] / 1000
    if slots.get("active") is not None:
        m["requests_processing"] = slots["active"]
    if live.get("queued") is not None:
        m["requests_deferred"] = live["queued"]
    return m, j


def metrics():
    """(llama.cpp-style counters, engine info or None)."""
    if ENGINE == "basalt":
        return basalt_metrics()
    if ENGINE == "maya":
        try:
            eng = get("/metrics", timeout=1)   # Maya's JSON /metrics: live + engine blocks (once per frame)
        except Exception:
            eng = None              # tolerate absence: no live line / header extras
        if isinstance(eng, dict):   # tolerate a malformed body: keep only dict blocks
            e, l, r, t = eng.get("engine"), eng.get("live"), eng.get("requests"), eng.get("totals")
            eng = {"engine": e if isinstance(e, dict) else {},
                   "live": l if isinstance(l, dict) else {},
                   "requests": r if isinstance(r, list) else [],
                   "totals": t if isinstance(t, dict) else {}}
        else:
            eng = None
        m = prom_metrics("/metrics/prometheus")   # running totals, the fallback when the JSON block is missing
        return m, eng    # rates come from eng's requests, never from frame-to-frame totals
    return prom_metrics("/metrics"), None


def server_info():
    """(model, ctx) from /v1/models, falling back to /props."""
    model, ctx = "?", None
    try:
        d = (get("/v1/models").get("data") or [{}])[0]
        model = d.get("id") or model
        ctx = (d.get("meta") or {}).get("n_ctx") or d.get("context_length")
    except Exception:
        pass
    try:
        props = get("/props")
        if model == "?":
            model = props.get("model_alias") or props.get("model_path", "?").rsplit("/", 1)[-1]
        ctx = ctx or (props.get("default_generation_settings") or {}).get("n_ctx")
    except Exception:
        pass
    return model, ctx


def gpu():
    try:
        q = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total,power.draw,temperature.gpu",
             "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=3).stdout.strip()
        u, mu, mt, pw, t = [x.strip() for x in q.splitlines()[0].split(",")]
        return f"GPU {u:>3}%  VRAM {float(mu)/1024:5.1f}/{float(mt)/1024:.1f} GiB  {float(pw):5.0f} W  {t} C"
    except Exception:
        return "GPU n/a"


def bar(frac, width=30):
    frac = max(0.0, min(1.0, frac))
    n = int(frac * width)
    return "[" + "#" * n + "-" * (width - n) + f"] {frac*100:5.1f}%"


PREV = {}


def rate(m, tok_key, sec_key):
    """(last, average) tok/s. last = most recently finished request(s); sticky. None = unknown."""
    tok, sec = m.get(tok_key), m.get(sec_key)
    if tok is None or sec is None:
        return None, None
    avg = tok / sec if sec > 0 else None   # no finished request yet: unknown, not 0
    if tok_key in PREV:
        dt, ds = tok - PREV[tok_key], sec - PREV[sec_key]
        if ds > 0:
            PREV[tok_key + "_last"] = dt / ds
    PREV[tok_key], PREV[sec_key] = tok, sec
    return PREV.get(tok_key + "_last"), avg


def fmt_rate(live, avg, now=None, avg_label="avg"):
    """(last, average) tok/s. now = the live in-flight rate (Maya, Basalt): shown as "now" instead of "last".
    avg_label names the window the avg covers; Maya passes "avg(N)" so the count is honest."""
    lab = "last"
    if is_num(now):
        live, lab = now, "now"
    l = f"{live:8.1f}" if live is not None else "       -"
    v = f"{avg:8.1f}" if avg is not None else "       -"
    return f"{lab:<4} {l} tok/s   {avg_label} {v} tok/s"


def num(v):
    return f"{int(v)}" if v is not None else "-"


def is_num(v):
    # finite int/float only: no bool, NaN or Infinity (JSON 1e309) reaching num() or ":.1f";
    # abs(v) < 1e18 first so isfinite never sees a huge int (OverflowError on a 400-digit JSON number)
    return isinstance(v, (int, float)) and not isinstance(v, bool) and abs(v) < 1e18 and math.isfinite(v)


def short_phase(p):
    """A phase in at most 10 ASCII characters: Basalt's long phase names get short labels, anything else is cut."""
    if not isinstance(p, str):
        return ""
    p = "tool call" if p.startswith("writing a tool call") else \
        {"reading the prompt": "reading", "tool call complete": "tool done"}.get(p, p)
    return p if len(p) <= 10 else p[:9] + "~"


def live_line(phase, ts, el, progress, mean=None, show_mean=False):
    """The Live line as fixed-width columns (phase, rate, [mean], elapsed), then the variable-length progress last,
    so a refresh never moves a column, in 80 columns for a typical Basalt line. None when there is nothing to show."""
    phase = short_phase(phase)
    if not (phase or is_num(ts) or (show_mean and is_num(mean)) or is_num(el) or progress):
        return None
    cols = [f"{phase:<10}", f"{ts:6.1f} tok/s" if is_num(ts) else " " * 12]
    if show_mean:
        cols.append(f"(mean {mean:5.1f})" if is_num(mean) else " " * 12)
    cols += [f"elapsed {el:6.1f} s" if is_num(el) else " " * 16, progress]
    return ("Live       " + "  ".join(cols)).rstrip()


def gen_progress(gen, mx):
    """"generated N[/max] tok", or "" when N is unknown; max 0/-1 = rest of the context, no slash."""
    if not is_num(gen):
        return ""
    return f"generated {num(gen)}" + (f"/{num(mx)}" if is_num(mx) and mx > 0 else "") + " tok"


def maya_ctx_used(lv, reqs):
    """Context in use on Maya's slot, or None. Maya's /slots has no used count, but its /metrics does: a running
    request's prompt plus what it has generated, else (idle) the most recent finished request's prompt plus output."""
    state = lv.get("state")
    if state in ("reading", "generating"):
        # Maya sets prompt_tokens and generated together when a request starts; a request resuming after a fair
        # slice re-reads with its earlier output already counted in generated
        p, g = lv.get("prompt_tokens"), lv.get("generated")
        if not (is_num(p) and p >= 0):
            return None
        return int(p + (g if is_num(g) and g >= 0 else 0))
    if state not in ("idle", "", None):   # unloaded: the engine and its cache are gone
        return None
    last = reqs[0] if reqs else {}   # newest first
    if not isinstance(last, dict):   # a bad newest row shows a dash, not an older request
        return None
    p, o = last.get("prompt_tokens"), last.get("output_tokens")
    if is_num(p) and p >= 0 and is_num(o) and o >= 0:
        return int(p + o)
    return None


MAYA_AVG_W = len("avg(12)")   # Maya lists at most 12 requests: the widest avg label to pad to
MAYA_LINE = 80               # Maya's rate lines and footer must fit an 80-column terminal


def maya_avg_label(n, avg):
    """Maya's avg label, padded to a fixed width so the Prefill and Generate columns line up whatever N is."""
    lab = f"avg({n})" if avg is not None else "avg"
    return lab.ljust(MAYA_AVG_W)


def maya_count(v):
    """Maya's token counts in at most 6 characters, so its rate lines fit 80 columns: 48987 -> "49.0k",
    12345678 -> "12.3M". The tier is the one whose mantissa stays below 1000.0, so 999999 renders "1.0M", and
    peta covers every count is_num() accepts (under 1e18 tokens), so the 6-character bound always holds."""
    if not is_num(v):
        return "-"
    v = int(v)
    if v < 1000:
        return str(v)
    for d, s in ((1000, "k"), (10 ** 6, "M"), (10 ** 9, "B"), (10 ** 12, "T"), (10 ** 15, "P")):
        if v < 999.95 * d:
            return f"{v / d:.1f}{s}"
    return f"{v / 10 ** 15:.0f}P"


def maya_short(v):
    """Maya's live progress counts in at most 4 characters for any count below a billion: one decimal below 10 of
    a tier, none above it, so 1234 -> "1.2k", 12345 -> "12k", 987654321 -> "988M". The tier is the one whose
    rounded mantissa stays below 1000, so 999999 renders "1.0M", never "1000k"."""
    if not is_num(v):
        return "-"
    v = int(v)
    if v < 1000:
        return str(v)
    for d, s in ((1000, "k"), (10 ** 6, "M"), (10 ** 9, "B"), (10 ** 12, "T"), (10 ** 15, "P")):
        if v < 9.95 * d:
            return f"{v / d:.1f}{s}"
        if v < 999.5 * d:
            return f"{v / d:.0f}{s}"
    return f"{v / 10 ** 15:.0f}P"


def maya_live_read(read, total):
    """Maya's live prefill suffix, always compact, worded like Basalt's: ", +12k/40k in flight". The counts use
    maya_short, so "+read/total in flight" is at most 20 characters for any count below a billion and fits the
    21 the Prefill line leaves for its parens. An exact one is never offered: the running counts plus the
    progress pass 80 columns for any real counts; the Live line above prints the raw read and total exactly."""
    return f", +{maya_short(read)}/{maya_short(total)} in flight"


def maya_live_gen(generated):
    """Maya's live generate suffix, worded like Basalt's, exact and compact: ", +412 in flight" /
    ", +412k in flight". The exact form still fits next to a small running count, so both are offered; the
    compact one uses maya_short, so it still fits beside a compacted running total ("98.8M, +12M in flight")."""
    return f", +{num(generated)} in flight", f", +{maya_short(generated)} in flight"


def maya_counts(base, cands):
    """Maya's count parens: the first candidate that keeps the whole line within 80 columns, as "  (…)".
    Candidates run from most to least detail: exact counts with the word "tok", the same without it (the line
    already says Prefill or Generate), the same counts compacted to k/M, and finally only the live progress,
    which is what the Live line shows too. The two rate lines share the separator, so their "(" columns line up."""
    for c in cands:
        if c and len(base) + len(c) <= MAYA_LINE - 4:   # "  (" + ")"
            return f"  ({c})"
    return f"  ({[c for c in cands if c][-1]})"


def maya_multi_call(r):
    """True when a listed request's prompt_ms cannot rate its whole prompt: VISIBLY multi-call, or UNKNOWN.
    Multi-call: the output covers more than the last call's engine_generated, with enough slack that two
    roughly equal calls (output = 2 * generated) are caught too: output > 1.1 * generated + 16.
    Unknown: engine_generated missing, None or 0 leaves nothing to compare against, and output beyond 16
    tokens cannot belong to a last call that generated (apparently) nothing.
    Both cases are treated alike wherever Prefill is computed: out of the avg, Prefill last shows "-".
    Single-call rows (output close to engine_generated, or ≤ 16 tokens with no generated) stay counted;
    a row without an output count cannot be judged either way."""
    o, g = r.get("output_tokens"), r.get("engine_generated")
    if not is_num(o):
        return False
    if not is_num(g) or g == 0:
        return o > 16
    return o > 1.1 * g + 16


def maya_figures(eng, m):
    """Maya's Prefill/Generate figures: (p_last, p_avg, p_n, g_last, g_avg, g_n, prompt, cached, output).

    Maya takes reused, engine_generated, prompt_ms and decode_ms from a request's LAST engine call while its
    prompt and output token counts cover the WHOLE request (one request can make several calls), so the mirrored
    Prometheus totals (prompt minus reused, output over decode_ms) go negative and yield bogus rates. Rates
    therefore come from consistent per-request sources, never from frame-to-frame differences of the totals:
      - last  = the newest listed request's own prefill_tok_s / decode_tok_s ("-" when Maya leaves them None);
                Generate "last" shows "-" when the newest request has no decode_tok_s (an error, a disconnect,
                or zero output). Prefill "last" also shows "-" when the newest row is flagged by
                maya_multi_call (multi-call or unknown): its prompt_ms covers only its last call at best, and
                an older request's rate would contradict the footer's "last = newest request".
      - avg   = the ratio of summed fresh-prompt and generated tokens to their ms over the listed requests whose
                pair is consistent (0 <= reused < prompt, prompt_ms > 0 and not flagged by maya_multi_call for
                prefill, engine_generated > 0 and decode_ms > 0 for decode); the count n labels that window.
    Counts are Maya's running totals (only ever grow): the total prompt_tokens (NOT prompt minus reused, which a
    multi-call request's faster-growing reused can push down), the cached reused count, and the true
    output_tokens. They read from the JSON totals; when the JSON fetch failed for this frame (rates then show
    "-") only the cached and output counts fall back to the Prometheus mirror, and the prompt count shows "-"
    rather than the mirror's different quantity (prompt minus reused). A malformed negative total clamps to 0:
    a count never renders negative."""
    def nz(v):   # a real number, else None
        return v if is_num(v) else None

    def z0(v):   # a count that renders: a malformed negative total clamps to 0, None stays "-"
        return None if v is None else max(0, v)
    reqs = eng["requests"] if eng else []
    t = eng["totals"] if eng else {}
    newest = reqs[0] if reqs and isinstance(reqs[0], dict) else None
    # running token counts: JSON totals first; the mirror's prompt_tokens_total is prompt minus reused, a
    # different quantity than Maya's growing total, so the prompt count has no fallback and shows "-"
    p = t.get("prompt_tokens")
    prompt = z0(p if is_num(p) else None)
    ru = t.get("reused")
    cached = z0(ru if is_num(ru) else nz(m.get("prompt_tokens_cached_total")))
    out = z0(t.get("output_tokens") if is_num(t.get("output_tokens")) else nz(m.get("tokens_predicted_total")))
    if not eng:
        return (None, None, 0, None, None, 0, prompt, cached, out)
    # last = the newest request's own per-call rate, never an older request's: the footer says "last = newest
    # request", so a newest row flagged by maya_multi_call (its prompt_ms covers only its last call at best)
    # dashes Prefill last rather than falling back to the row below it
    p_last = None
    if newest is not None and not maya_multi_call(newest):
        v = newest.get("prefill_tok_s")
        p_last = v if is_num(v) and v > 0 else None
    g_last = newest.get("decode_tok_s") if newest else None
    g_last = g_last if is_num(g_last) and g_last > 0 else None
    # avg = ratio of summed tokens to summed ms over the requests whose pair describes the same call
    pf = pms = pn = 0
    for r in reqs:
        if not isinstance(r, dict) or maya_multi_call(r):   # a flagged row's prompt_ms is not its whole prompt
            continue
        rp, rr, rms = r.get("prompt_tokens"), r.get("reused"), r.get("prompt_ms")
        rr = rr if is_num(rr) and rr >= 0 else 0   # a fresh request with no reused field reused nothing
        if is_num(rp) and rp > rr and is_num(rms) and rms > 0:
            pf, pms, pn = pf + (rp - rr), pms + rms, pn + 1
    gf = gms = gn = 0
    for r in reqs:
        if not isinstance(r, dict):
            continue
        gen, dm = r.get("engine_generated"), r.get("decode_ms")
        if is_num(gen) and gen > 0 and is_num(dm) and dm > 0:
            gf, gms, gn = gf + gen, gms + dm, gn + 1
    p_avg = pf / (pms / 1000) if pn > 0 else None
    g_avg = gf / (gms / 1000) if gn > 0 else None
    return (p_last, p_avg, pn, g_last, g_avg, gn, prompt, cached, out)


def render():
    global ENGINE, LAST_DETECT
    if AUTO and ENGINE is None:
        ENGINE = detect()  # retried every frame until the server answers
        LAST_DETECT = time.monotonic()
    elif AUTO and time.monotonic() - LAST_DETECT >= 5:
        LAST_DETECT = time.monotonic()  # re-check even on success: the server may have been swapped
        detected = detect()
        if detected and detected != ENGINE:
            ENGINE = detected
            PREV.clear()
    try:
        m, eng = metrics()
    except Exception as e:
        hint = "\nIs llama-server running with --metrics?  (llm-serve)" if ENGINE in (None, "llamacpp") else ""
        if AUTO:
            ENGINE = None  # server may be restarting or swapped: re-detect next frame
            PREV.clear()
        return f"Cannot reach {BASE} ({e}).{hint}"
    model, ctx = server_info()
    try:
        slots = get("/slots")
    except Exception:
        slots = []
    if ctx is None and slots:
        ctx = slots[0].get("n_ctx")

    lines = []
    head = f"{NAMES.get(ENGINE) or 'llama.cpp'} @ {BASE}   model: {model}   ctx: {ctx if ctx else '-'}"
    if ENGINE == "basalt":
        e = (eng or {}).get("engine") or {}
        extra = ", ".join(x for x in [f"basalt {e['version']}" if e.get("version") else "",
                                      e.get("quant") or "", f"kv {e['kv']}" if e.get("kv") else ""] if x)
        head += f"   {extra}" if extra else ""
    elif ENGINE == "maya":
        e = (eng or {}).get("engine") or {}
        extra = ", ".join(x for x in [str(e.get("model_label") or ""), str(e.get("version") or ""),
                                      f"kv {e['kv']}" if e.get("kv") else ""] if x)
        head += f"   {extra}" if extra else ""
    lines.append(head)
    lines.append("-" * 72)
    lines.append(f"Load       processing: {num(m.get('requests_processing'))}   "
                 f"queued: {num(m.get('requests_deferred'))}")
    lv, state = {}, None   # Maya/Basalt live block, so the prefill/generate block below never depends on the one above
    if ENGINE == "maya":
        lv = (eng or {}).get("live") or {}
        state = lv.get("state")
        if isinstance(state, str) and state and state != "idle":   # live progress while generating; "" = no request
            pr, pt = lv.get("prompt_read"), lv.get("prompt_total")
            if state == "reading" and is_num(pr) and is_num(pt):
                prog = f"prompt {num(pr)}/{num(pt)} tok"   # Maya sets these only while reading
            else:
                prog = gen_progress(lv.get("generated"), lv.get("max_tokens"))
            ts = lv.get("tok_s")
            ln = live_line(lv.get("phase"), ts, lv.get("elapsed_s"), prog,
                           mean=lv.get("tok_s_mean") if is_num(ts) else None, show_mean=True)
            if ln:
                lines.append(ln)
    elif ENGINE == "basalt":
        lv = (eng or {}).get("live")
        lv = lv if isinstance(lv, dict) else {}
        state = lv.get("state")
        busy = [r for r in slots if isinstance(r, dict) and r.get("is_processing")] if isinstance(slots, list) else []
        row = busy[0] if len(busy) == 1 else {}   # the one running request's slot row; {} when several or none
        multi = len(busy) > 1   # live's tok_s sums every request, its phase/generated/elapsed are the newest one's only
        gen_all = sum(r["generated"] for r in busy if is_num(r.get("generated")))
        if state in ("reading", "generating") and multi:
            ln = live_line(None, lv.get("tok_s") if state == "generating" else None, None,
                           f"{len(busy)} requests, generated {num(gen_all)} tok")
            if ln:
                lines.append(ln)
        elif state in ("reading", "generating"):
            # with parallel requests the live block is the newest request's, which may still wait for a slot
            # while another one runs: then its phase and elapsed time are not this slot's
            own = not (is_num(row.get("prompt_tokens")) and lv.get("prompt_tokens") != row["prompt_tokens"])
            if state == "reading":
                done, tot = row.get("prefill_done"), row.get("prompt_tokens")
                if is_num(done) and is_num(tot):
                    prog = f"prompt {num(done)}/{num(tot)} tok"
                else:
                    prog = f"prompt {num(lv['prompt_tokens'])} tok" if is_num(lv.get("prompt_tokens")) else ""
            else:
                prog = gen_progress(row["generated"] if is_num(row.get("generated")) else lv.get("generated"),
                                    row.get("max_tokens"))
            ln = live_line(lv.get("phase") if own else None, lv.get("tok_s") if state == "generating" else None,
                           lv.get("elapsed_s") if own else None, prog)
            if ln:
                lines.append(ln)
    pnow = gnow = None   # live rate overrides (Maya, Basalt): shown instead of "last" while a request runs
    psuf = gsuf = ""     # "in flight" suffixes, only ever set together with their override
    gsuf_k = ""          # Maya: compact generate suffix, used once the exact one would pass 80 columns
    if ENGINE == "maya":   # Maya's counters only move when a request ends
        ptk = lv.get("prompt_tokens")   # the current request's prompt length, set the moment it starts
        pv = lv.get("prefill_tok_s_mean")
        # just after a request starts, live still holds the previous request's reading values: they end at
        # prompt_total - 1 (the engine reads n-1 tokens and feeds the last one into the first decode step)
        # or at prompt_total, so require a read still short of prompt_total - 1;
        # a negative prompt_read means there is no live prefill at all
        reading = (is_num(ptk) and lv.get("prompt_total") == ptk
                   and is_num(lv.get("prompt_total")) and is_num(lv.get("prompt_read"))
                   and 0 <= lv["prompt_read"] < lv["prompt_total"] - 1)
        if state == "reading" and reading and is_num(pv) and pv > 0:
            pnow = pv
            pr, pt, ru = lv.get("prompt_read"), ptk, lv.get("prompt_reused")
            if is_num(ru) and ru >= pt:   # the whole prompt is cached: nothing fresh left to count
                psuf = ""
            else:
                if is_num(ru) and 0 < ru < pt:   # prompt_read includes the cached prefix: count only fresh tokens
                    pr, pt = max(pr - ru, 0), max(pt - ru, 0)
                psuf = maya_live_read(pr, pt)
        elif state == "generating":
            ts = lv.get("tok_s")
            if is_num(ts) and ts >= 0:
                gnow = ts if ts else 0.0   # -0.0 would render "-0.0"
                if is_num(lv.get("generated")) and lv["generated"] >= 0:
                    gsuf, gsuf_k = maya_live_gen(lv["generated"])
    elif ENGINE == "basalt":   # Basalt's totals, like Maya's counters, only move when a request ends
        pv, ts = lv.get("prefill_tok_s_mean"), lv.get("tok_s")
        gen = gen_all if multi else row["generated"] if is_num(row.get("generated")) else lv.get("generated")
        pr, pt, ru = row.get("prefill_done"), row.get("prompt_tokens"), row.get("reused")
        # the batched engine keeps the previous request's prefill rate until this read reports progress,
        # so require the slot's own progress first; with several requests the rate has no single owner
        if state == "reading" and is_num(pv) and pv > 0 and is_num(pr) and is_num(pt) and 0 < pr <= pt:
            pnow = pv
            if is_num(ru) and 0 <= ru < pt:   # prefill_done includes the cached prefix: count only fresh tokens
                psuf = f", +{num(max(pr - ru, 0))}/{num(pt - ru)} in flight"
            elif not is_num(ru):   # Basalt reports the cached prefix only at the first token
                psuf = f", {num(pr)}/{num(pt)} read incl. cached"
        elif state == "generating" and is_num(ts) and ts >= 0:
            gnow = ts if ts else 0.0   # -0.0 would render "-0.0"
            if is_num(gen) and gen >= 0:
                gsuf = f", +{num(gen)} in flight"
    if ENGINE == "maya":   # Maya's counters only move when a request ends and a request can span several calls
        pl, pa, pn, gl, ga, gn, prompt, cached, out = maya_figures(eng, m)
        # the count parens shorten until the line fits 80 columns, so 8-digit counts never wrap
        pre = "Prefill    " + fmt_rate(pl, pa, now=pnow, avg_label=maya_avg_label(pn, pa))
        gen = "Generate   " + fmt_rate(gl, ga, now=gnow, avg_label=maya_avg_label(gn, ga))
        lines.append(pre + maya_counts(pre, [
            f"{num(prompt)} tok, {num(cached)} cached{psuf}",
            f"{num(prompt)}, {num(cached)} cached{psuf}",   # the line already says Prefill: "tok" can go
            f"{maya_count(prompt)} tok, {maya_count(cached)} cached{psuf}",
            f"{maya_count(prompt)}, {maya_count(cached)} cached{psuf}",
            psuf.lstrip(", ")]))                           # live progress alone, as the Live line shows it
        lines.append(gen + maya_counts(gen, [
            f"{num(out)} tok{gsuf}",
            f"{maya_count(out)} tok{gsuf_k}",
            f"{maya_count(out)}{gsuf_k}",
            gsuf_k.lstrip(", ")]))
    else:
        lines.append("Prefill    " + fmt_rate(*rate(m, "prompt_tokens_total", "prompt_seconds_total"), now=pnow)
                     + f"   ({num(m.get('prompt_tokens_total'))} tok, "
                     f"{num(m.get('prompt_tokens_cached_total'))} cached{psuf})")
        lines.append("Generate   " + fmt_rate(*rate(m, "tokens_predicted_total", "tokens_predicted_seconds_total"), now=gnow)
                     + f"   ({num(m.get('tokens_predicted_total'))} tok{gsuf})")
    if ENGINE == "basalt":
        off = sum(s["drafts_offered"] for s in slots if s.get("drafts_offered") is not None)
        acc = sum(s["drafts_accepted"] for s in slots if s.get("drafts_accepted") is not None)
        if off or acc:
            lines.append(f"Draft (last req) accepted {acc}/{off}" + (f"  ({acc/off*100:.1f}%)" if off else ""))
    else:
        d = m.get("spec_decode_num_draft_tokens_total")
        if d is not None:
            acc = m.get("spec_decode_num_accepted_tokens_total", 0)
            lines.append(f"Draft      accepted {int(acc)}/{int(d)}" + (f"  ({acc/d*100:.1f}%)" if d else ""))

    now = time.monotonic()
    for s in slots:
        sid = s.get("id", 0)
        n_ctx = s.get("n_ctx", 0) or 1
        state = "busy" if s.get("is_processing") else "idle"
        if ENGINE == "maya":
            used = maya_ctx_used(lv, (eng or {}).get("requests") or [])
            if used is None:
                lines.append(f"Slot {sid}     {state:<5} ctx {'-':>7}/{n_ctx}")
            else:
                used = min(used, n_ctx)
                lines.append(f"Slot {sid}     {state:<5} ctx {used:>7}/{n_ctx}  {bar(used / n_ctx, 20)}")
            continue
        if ENGINE == "basalt":
            used = s.get("ctx_used", 0) or 0
            ts = s.get("tok_s") or 0.0
            live = f"  gen now {ts:6.1f} tok/s" if s.get("is_processing") and ts > 0 else ""
        else:
            nt = s.get("next_token")
            nt = nt[0] if isinstance(nt, list) and nt else (nt or {})
            dec = nt.get("n_decoded", 0) or 0
            used = (s.get("n_prompt_tokens", 0) or 0) + dec
            key = f"slot{sid}"
            live = ""
            if s.get("is_processing") and key in PREV:
                pdec, pt = PREV[key]
                if dec >= pdec and now > pt:
                    live = f"  gen now {(dec - pdec) / (now - pt):6.1f} tok/s"
            PREV[key] = (dec, now)
        lines.append(f"Slot {sid}     {state:<5} ctx {used:>7}/{n_ctx}  {bar(used / n_ctx, 20)}{live}")

    lines.append(gpu())
    lines.append("-" * 72)
    # Maya's avg covers only the requests its list holds, not the server's whole uptime; the whole footer stays
    # inside 80 columns
    footer = ("last = newest request, avg(N) = over the N listed. Ctrl+C to exit." if ENGINE == "maya"
              else "last = most recent request, avg = since server start. Ctrl+C to exit.")
    lines.append(footer)
    return "\n".join(lines)


def main():
    a = p.parse_args()
    configure(a)
    try:
        while True:
            out = render()
            if a.once:
                print(out)
                break
            sys.stdout.write("\033[H\033[2J" + out + "\n")
            sys.stdout.flush()
            time.sleep(a.interval)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
