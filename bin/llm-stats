#!/usr/bin/env python3
"""llm-stats - live dashboard for a running llama.cpp, Basalt or Maya server.

Usage: llm-stats [--port 8000] [--host localhost] [--interval 1] [--once] [--engine auto]
--engine auto (default) detects the engine from /health and /v1/status, and re-detects if the server goes away or changes.
Requires llama-server started with --metrics (llm-serve does this).
"""
import argparse, json, math, re, subprocess, sys, time, urllib.request

p = argparse.ArgumentParser()
p.add_argument("--host", default="localhost")
p.add_argument("--port", type=int, default=8000)
p.add_argument("--interval", type=float, default=1.0)
p.add_argument("--once", action="store_true")
p.add_argument("--engine", choices=["auto", "llamacpp", "basalt", "maya"], default="auto")
a = p.parse_args()
BASE = f"http://{a.host}:{a.port}"
NAMES = {"llamacpp": "llama.cpp", "basalt": "Basalt", "maya": "Maya"}
ENGINE = None if a.engine == "auto" else a.engine  # None = not detected yet
AUTO = a.engine == "auto"      # only auto mode may re-detect the engine after start
LAST_DETECT = 0.0              # monotonic time of the last detect() in auto mode


def get(path, as_json=True, timeout=2):
    with urllib.request.urlopen(BASE + path, timeout=timeout) as r:
        body = r.read().decode()
    return json.loads(body) if as_json else body


def detect():
    """Engine id from the server's own reports, or None when unreachable."""
    ok = False
    try:
        if get("/health").get("service") == "basalt":
            return "basalt"
        ok = True
    except Exception:
        pass
    try:
        if get("/v1/status").get("service") == "maya":
            return "maya"
        ok = True
    except Exception:
        pass
    return "llamacpp" if ok else None


def prom_metrics(path):
    out = {}
    for line in get(path, as_json=False).splitlines():
        m = re.match(r"^llamacpp:(\w+)(?:\{[^}]*\})?\s+([-\d.eE+naNinf]+)$", line)
        if m:
            out[m.group(1)] = float(m.group(2))
    return out


def basalt_metrics():
    """Basalt's JSON /metrics mapped onto the llama.cpp counter names."""
    j = get("/metrics")
    t, live = j.get("totals") or {}, j.get("live") or {}
    slots = live.get("slots") or {}
    m, prompt, reused = {}, t.get("prompt"), t.get("reused")
    if prompt is not None:
        m["prompt_tokens_total"] = prompt - (reused or 0)
    if reused is not None:
        m["prompt_tokens_cached_total"] = reused
    if t.get("prompt_ms") is not None:
        m["prompt_seconds_total"] = t["prompt_ms"] / 1000
    if t.get("written") is not None:
        m["tokens_predicted_total"] = t["written"]
    if t.get("decode_ms") is not None:
        m["tokens_predicted_seconds_total"] = t["decode_ms"] / 1000
    if slots.get("active") is not None:
        m["requests_processing"] = slots["active"]
    if live.get("queued") is not None:
        m["requests_deferred"] = live["queued"]
    return m, j


def metrics():
    """(llama.cpp-style counters, engine info or None)."""
    if ENGINE == "basalt":
        return basalt_metrics()
    if ENGINE == "maya":
        try:
            eng = get("/metrics", timeout=1)   # Maya's JSON /metrics: live + engine blocks (once per frame)
        except Exception:
            eng = None              # tolerate absence: no live line / header extras
        if isinstance(eng, dict):   # tolerate a malformed body: keep only dict blocks
            e, l = eng.get("engine"), eng.get("live")
            eng = {"engine": e if isinstance(e, dict) else {},
                   "live": l if isinstance(l, dict) else {}}
        else:
            eng = None
        return prom_metrics("/metrics/prometheus"), eng    # counters come from the Prometheus text
    return prom_metrics("/metrics"), None


def server_info():
    """(model, ctx) from /v1/models, falling back to /props."""
    model, ctx = "?", None
    try:
        d = (get("/v1/models").get("data") or [{}])[0]
        model = d.get("id") or model
        ctx = (d.get("meta") or {}).get("n_ctx") or d.get("context_length")
    except Exception:
        pass
    try:
        props = get("/props")
        if model == "?":
            model = props.get("model_alias") or props.get("model_path", "?").rsplit("/", 1)[-1]
        ctx = ctx or (props.get("default_generation_settings") or {}).get("n_ctx")
    except Exception:
        pass
    return model, ctx


def gpu():
    try:
        q = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total,power.draw,temperature.gpu",
             "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=3).stdout.strip()
        u, mu, mt, pw, t = [x.strip() for x in q.splitlines()[0].split(",")]
        return f"GPU {u:>3}%  VRAM {float(mu)/1024:5.1f}/{float(mt)/1024:.1f} GiB  {float(pw):5.0f} W  {t} C"
    except Exception:
        return "GPU n/a"


def bar(frac, width=30):
    frac = max(0.0, min(1.0, frac))
    n = int(frac * width)
    return "[" + "#" * n + "-" * (width - n) + f"] {frac*100:5.1f}%"


PREV = {}


def rate(m, tok_key, sec_key):
    """(last, average) tok/s. last = most recently finished request(s); sticky. None = unknown."""
    tok, sec = m.get(tok_key), m.get(sec_key)
    if tok is None or sec is None:
        return None, None
    avg = tok / sec if sec > 0 else None   # no finished request yet: unknown, not 0
    if tok_key in PREV:
        dt, ds = tok - PREV[tok_key], sec - PREV[sec_key]
        if ds > 0:
            PREV[tok_key + "_last"] = dt / ds
    PREV[tok_key], PREV[sec_key] = tok, sec
    return PREV.get(tok_key + "_last"), avg


def fmt_rate(live, avg, now=None):
    """(last, average) tok/s. now = Maya's live in-flight rate: shown as "now" instead of "last"."""
    lab = "last"
    if is_num(now):
        live, lab = now, "now "   # "now " pads to 4 chars: "last" columns stay aligned
    l = f"{live:8.1f}" if live is not None else "       -"
    v = f"{avg:8.1f}" if avg is not None else "       -"
    return f"{lab} {l} tok/s   avg {v} tok/s"


def num(v):
    return f"{int(v)}" if v is not None else "-"


def is_num(v):
    # finite int/float only: no bool, NaN or Infinity (JSON 1e309) reaching num() or ":.1f";
    # abs(v) < 1e18 first so isfinite never sees a huge int (OverflowError on a 400-digit JSON number)
    return isinstance(v, (int, float)) and not isinstance(v, bool) and abs(v) < 1e18 and math.isfinite(v)


def render():
    global ENGINE, LAST_DETECT
    if AUTO and ENGINE is None:
        ENGINE = detect()  # retried every frame until the server answers
        LAST_DETECT = time.monotonic()
    elif AUTO and time.monotonic() - LAST_DETECT >= 5:
        LAST_DETECT = time.monotonic()  # re-check even on success: the server may have been swapped
        detected = detect()
        if detected and detected != ENGINE:
            ENGINE = detected
            PREV.clear()
    try:
        m, eng = metrics()
    except Exception as e:
        hint = "\nIs llama-server running with --metrics?  (llm-serve)" if ENGINE in (None, "llamacpp") else ""
        if AUTO:
            ENGINE = None  # server may be restarting or swapped: re-detect next frame
            PREV.clear()
        return f"Cannot reach {BASE} ({e}).{hint}"
    model, ctx = server_info()
    try:
        slots = get("/slots")
    except Exception:
        slots = []
    if ctx is None and slots:
        ctx = slots[0].get("n_ctx")

    lines = []
    head = f"{NAMES.get(ENGINE) or 'llama.cpp'} @ {BASE}   model: {model}   ctx: {ctx if ctx else '-'}"
    if ENGINE == "basalt":
        e = (eng or {}).get("engine") or {}
        extra = ", ".join(x for x in [f"basalt {e['version']}" if e.get("version") else "",
                                      e.get("quant") or "", f"kv {e['kv']}" if e.get("kv") else ""] if x)
        head += f"   {extra}" if extra else ""
    elif ENGINE == "maya":
        e = (eng or {}).get("engine") or {}
        extra = ", ".join(x for x in [str(e.get("model_label") or ""), str(e.get("version") or ""),
                                      f"kv {e['kv']}" if e.get("kv") else ""] if x)
        head += f"   {extra}" if extra else ""
    lines.append(head)
    lines.append("-" * 72)
    lines.append(f"Load       processing: {num(m.get('requests_processing'))}   "
                 f"queued: {num(m.get('requests_deferred'))}")
    if ENGINE == "maya":
        lv = (eng or {}).get("live") or {}
        state = lv.get("state")
        if isinstance(state, str) and state and state != "idle":   # live progress while generating; "" = no request
            parts = [lv["phase"]] if isinstance(lv.get("phase"), str) and lv["phase"] else []
            pr, pt = lv.get("prompt_read"), lv.get("prompt_total")
            if state == "reading" and is_num(pr) and is_num(pt):
                parts.append(f"prompt {num(pr)}/{num(pt)} tok")   # Maya sets these only while reading
            elif is_num(lv.get("generated")):
                g = f"generated {num(lv['generated'])}"
                if is_num(lv.get("max_tokens")) and lv["max_tokens"] > 0:   # 0/-1 = rest of the context
                    g += f"/{num(lv['max_tokens'])}"
                parts.append(g + " tok")
            if is_num(lv.get("tok_s")):
                r = f"{lv['tok_s']:.1f} tok/s now"
                if is_num(lv.get("tok_s_mean")):
                    r += f" (mean {lv['tok_s_mean']:.1f})"
                parts.append(r)
            if is_num(lv.get("elapsed_s")):
                parts.append(f"elapsed {lv['elapsed_s']:.1f} s")
            if parts:
                lines.append("Live       " + "  ".join(parts))
    pnow = gnow = None   # Maya live rate overrides: shown instead of "last" while a request runs
    psuf = gsuf = ""     # "in flight" suffixes, only ever set together with their override
    if ENGINE == "maya":   # Maya's counters only move when a request ends: lv is set above
        st = lv.get("state")
        if st == "reading" and is_num(lv.get("prefill_tok_s_mean")):
            pnow = lv["prefill_tok_s_mean"]
            if is_num(lv.get("prompt_read")) and is_num(lv.get("prompt_total")):
                psuf = f", +{num(lv['prompt_read'])}/{num(lv['prompt_total'])} in flight"
        elif st == "generating" and is_num(lv.get("tok_s")):
            gnow = lv["tok_s"]
            if is_num(lv.get("generated")):
                gsuf = f", +{num(lv['generated'])} in flight"
    lines.append("Prefill    " + fmt_rate(*rate(m, "prompt_tokens_total", "prompt_seconds_total"), now=pnow)
                 + f"   ({num(m.get('prompt_tokens_total'))} tok, "
                 f"{num(m.get('prompt_tokens_cached_total'))} cached{psuf})")
    lines.append("Generate   " + fmt_rate(*rate(m, "tokens_predicted_total", "tokens_predicted_seconds_total"), now=gnow)
                 + f"   ({num(m.get('tokens_predicted_total'))} tok{gsuf})")
    if ENGINE == "basalt":
        off = sum(s["drafts_offered"] for s in slots if s.get("drafts_offered") is not None)
        acc = sum(s["drafts_accepted"] for s in slots if s.get("drafts_accepted") is not None)
        if off or acc:
            lines.append(f"Draft (last req) accepted {acc}/{off}" + (f"  ({acc/off*100:.1f}%)" if off else ""))
    else:
        d = m.get("spec_decode_num_draft_tokens_total")
        if d is not None:
            acc = m.get("spec_decode_num_accepted_tokens_total", 0)
            lines.append(f"Draft      accepted {int(acc)}/{int(d)}" + (f"  ({acc/d*100:.1f}%)" if d else ""))

    now = time.monotonic()
    for s in slots:
        sid = s.get("id", 0)
        n_ctx = s.get("n_ctx", 0) or 1
        state = "busy" if s.get("is_processing") else "idle"
        if ENGINE == "maya":
            lines.append(f"Slot {sid}     {state:<5} ctx {'-':>7}/{n_ctx}")   # Maya gives no used ctx
            continue
        if ENGINE == "basalt":
            used = s.get("ctx_used", 0) or 0
            ts = s.get("tok_s") or 0.0
            live = f"  gen now {ts:6.1f} tok/s" if s.get("is_processing") and ts > 0 else ""
        else:
            nt = s.get("next_token")
            nt = nt[0] if isinstance(nt, list) and nt else (nt or {})
            dec = nt.get("n_decoded", 0) or 0
            used = (s.get("n_prompt_tokens", 0) or 0) + dec
            key = f"slot{sid}"
            live = ""
            if s.get("is_processing") and key in PREV:
                pdec, pt = PREV[key]
                if dec >= pdec and now > pt:
                    live = f"  gen now {(dec - pdec) / (now - pt):6.1f} tok/s"
            PREV[key] = (dec, now)
        lines.append(f"Slot {sid}     {state:<5} ctx {used:>7}/{n_ctx}  {bar(used / n_ctx, 20)}{live}")

    lines.append(gpu())
    lines.append("-" * 72)
    lines.append("last = most recent request, avg = since server start. Ctrl+C to exit.")
    return "\n".join(lines)


try:
    while True:
        out = render()
        if a.once:
            print(out)
            break
        sys.stdout.write("\033[H\033[2J" + out + "\n")
        sys.stdout.flush()
        time.sleep(a.interval)
except KeyboardInterrupt:
    pass
